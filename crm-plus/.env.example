# ─── App ──────────────────────────────────────────────────────────────────────
# Public URL (used by NextAuth and outbound links)
NEXT_PUBLIC_APP_URL=https://app.yourcompany.com

NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase / PostgreSQL connection string
# Supabase: Project Settings → Database → Connection string (URI mode)
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Must match NEXT_PUBLIC_APP_URL in production
NEXTAUTH_URL=https://app.yourcompany.com
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Options: claude | mock
# Set to "mock" to disable real AI calls (no API key needed)
AI_PROVIDER=claude

# Anthropic (Claude) — required when AI_PROVIDER=claude
# Get key at: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Override model (default: claude-haiku-4-5-20251001)
# Faster/cheaper: claude-haiku-4-5-20251001
# More capable:   claude-sonnet-4-6
# AI_MODEL=claude-haiku-4-5-20251001

# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
# Meta Developer Console → App → WhatsApp → API Setup
#
# Phone Number ID (from the WhatsApp Business Account phone number)
WHATSAPP_PHONE_NUMBER_ID=

# Permanent system user access token (not the temp token from the dashboard)
WHATSAPP_ACCESS_TOKEN=

# Verify token — set a random string, enter the same value in Meta webhook config
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-verify-token

# App secret — Meta Developer Console → App Settings → Basic → App Secret
# Used for HMAC webhook signature verification when WEBHOOK_SIGNATURE_REQUIRED=true
WHATSAPP_WEBHOOK_SECRET=

# ─── Instagram Messaging API ───────────────────────────────────────────────────
# Meta Developer Console → App → Instagram → API Setup
#
# Page ID associated with the Instagram Professional account
INSTAGRAM_PAGE_ID=

# Page access token with instagram_manage_messages permission
INSTAGRAM_ACCESS_TOKEN=

# Verify token — same pattern as WhatsApp above
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-random-verify-token

# App secret for HMAC verification
INSTAGRAM_WEBHOOK_SECRET=

# ─── Webhook Security ─────────────────────────────────────────────────────────
# Set to "true" to enforce HMAC-SHA256 signature verification on webhook POSTs
# Leave empty or "false" for local development / simulation mode
WEBHOOK_SIGNATURE_REQUIRED=false

# Fallback HMAC secret used when channel-specific secret is not set
# WEBHOOK_SECRET=

# ─── Vercel-specific (set in Vercel dashboard, not in .env file) ──────────────
# All variables above should be added in: Vercel Project → Settings → Environment Variables
# Tip: use Vercel CLI: vercel env pull .env.local
